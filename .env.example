# Assistive Navigation - API Keys
# Copy this file to .env and replace placeholders with your actual keys.

# Google Gemini API Key
GOOGLE_API_KEY=your_gemini_api_key_here

# Groq API Key (for STT/Whisper)
GROQ_API_KEY=your_groq_api_key_here

# Hardware Port (Optional, e.g., /dev/ttyACM0)
# SERIAL_PORT=/dev/ttyACM0
